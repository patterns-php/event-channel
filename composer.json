{
    "name": "patterns/event-channel",
    "description": "Event Channel pattern - a transport-agnostic contract for publishing and subscribing to named events.",
    "type": "library",
    "keywords": [
        "event",
        "events",
        "channel",
        "pattern",
        "pubsub",
        "publish",
        "subscribe",
        "contract"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Patterns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Patterns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
